# SQLite database (Prisma) — file path is relative to the schema location
DATABASE_URL="file:./prisma/dev.db"

# App
APP_URL="http://localhost:3000"   # public origin for login and task email links

# JWT signing
JWT_SECRET=""                     # `openssl rand -base64 32`

# SMTP (Mailgun EU, STARTTLS on 587)
SMTP_HOST="smtp.eu.mailgun.org"
SMTP_PORT="587"
SMTP_SECURE="false"               # false = use STARTTLS (587); true = implicit TLS (465)
SMTP_USER="wardly@benritec.com"
SMTP_PASS=""                      # Mailgun SMTP password
SMTP_FROM='"Wardly" <wardly@benritec.com>'

# Cron
CRON_SECRET=""                    # bearer token protecting /api/cron/*

# Development only: fixed login code 123456, no email sent.
# dev:demo enables this automatically with a separate database.
LOCAL_AUTH_BYPASS="false"

# Sunday task reminders: auto = enabled in production, disabled in development.
# true opts development in; false disables. Demo login always disables reminders.
TASK_REMINDERS_ENABLED="auto"
