generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model ward {
  id             String   @id @default(uuid())
  name           String
  type           String   @default("ward") // 'ward' | 'branch'
  content_locale String   @default("en")
  time_zone      String   @default("UTC")
  created_at     DateTime @default(now())
  updated_at     DateTime @default(now())

  user                       user[]
  member                     member[]
  task                       task[]
  task_type                  task_type[]
  task_type_state            task_type_state[]
  task_type_state_assignment task_type_state_assignment[]
  sunday_meeting             sunday_meeting[]
}

model user {
  id         String   @id @default(uuid())
  ward_id    String
  email      String
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  ward  ward   @relation(fields: [ward_id], references: [id], onDelete: Cascade)
  login login?

  // Tasks assigned to this user
  task                       task[]
  // States that reassign to this user
  task_type_state_assignment task_type_state_assignment[]

  @@unique([email])
  @@index([ward_id])
}

model login {
  user_id       String
  token_hash    String
  code_hash     String
  attempts      Int      @default(0)
  redirect_path String?
  created_at    DateTime @default(now())

  user user @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id])
  @@unique([token_hash])
  @@index([created_at])
}

model member {
  id          String   @id @default(uuid())
  ward_id     String
  first_name  String
  last_name   String
  gender      String
  birth_date  String?
  email       String?
  is_baptized Boolean
  status      String   @default("active") // 'active' | 'moved' | 'unknown' | 'unknown_address' | 'no_contact' | 'hidden'
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())

  ward ward   @relation(fields: [ward_id], references: [id], onDelete: Cascade)
  task task[]
  sunday_meeting_person_assignment sunday_meeting_person_assignment[]

  @@index([ward_id])
  @@index([ward_id, status])
}

model task {
  id               String   @id @default(uuid())
  ward_id          String
  type             String
  state            String   @default("todo")
  title            String?
  description      String?
  assigned_user_id String?
  member_id        String?
  due_date         String?
  priority         String   @default("normal") // 'urgent' | 'normal' | 'whenever'
  duration_minutes Int?
  completed_at     String?
  created_at       DateTime @default(now())
  updated_at       DateTime @default(now())

  ward          ward    @relation(fields: [ward_id], references: [id], onDelete: Cascade)
  assigned_user user?   @relation(fields: [assigned_user_id], references: [id], onDelete: SetNull)
  member        member? @relation(fields: [member_id], references: [id], onDelete: SetNull)
  sunday_meeting_item sunday_meeting_item[]

  @@index([ward_id])
  @@index([ward_id, type, state])
  @@index([assigned_user_id])
  @@index([member_id])
  @@index([due_date])
  @@index([completed_at])
  @@index([ward_id, completed_at])
}

model task_type {
  ward_id       String
  type          String // Code-default or custom task type identifier
  name          String
  name_short    String   @default("T")
  color         String   @default("#71717a")
  configuration String   @default("{}")
  enabled       Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now())

  ward ward @relation(fields: [ward_id], references: [id], onDelete: Cascade)

  @@id([ward_id, type])
}

model task_type_state {
  id                       String   @id @default(uuid())
  ward_id                  String
  task_type                String
  state                    String
  label                    String
  color                    String   @default("#3b82f6")
  order_index              Int      @default(0)
  state_group              String   @default("active") // 'not_started' | 'active' | 'closed'
  sunday_meeting_item_type String?
  created_at               DateTime @default(now())
  updated_at               DateTime @default(now())

  ward ward @relation(fields: [ward_id], references: [id], onDelete: Cascade)

  @@unique([ward_id, task_type, state])
  @@index([task_type])
  @@index([ward_id])
}

model task_type_state_assignment {
  ward_id           String
  task_type         String
  state             String
  assign_to_user_id String?
  created_at        DateTime @default(now())
  updated_at        DateTime @default(now())

  ward           ward  @relation(fields: [ward_id], references: [id], onDelete: Cascade)
  assign_to_user user? @relation(fields: [assign_to_user_id], references: [id], onDelete: SetNull)

  @@id([ward_id, task_type, state])
  @@index([assign_to_user_id])
}

model sunday_meeting {
  id          String   @id @default(uuid())
  ward_id     String
  date        String
  type        String
  information String?
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())

  ward                             ward                             @relation(fields: [ward_id], references: [id], onDelete: Cascade)
  sunday_meeting_item              sunday_meeting_item[]
  sunday_meeting_person_assignment sunday_meeting_person_assignment[]

  @@unique([ward_id, date])
  @@index([ward_id, type, date])
}

model sunday_meeting_item {
  id                String   @id @default(uuid())
  sunday_meeting_id String
  type              String
  section           String
  standard_slot     String?
  order_index       Int
  content           String?
  hymn_number       Int?
  task_id           String?
  created_at        DateTime @default(now())
  updated_at        DateTime @default(now())

  sunday_meeting                    sunday_meeting                    @relation(fields: [sunday_meeting_id], references: [id], onDelete: Cascade)
  task                              task?                             @relation(fields: [task_id], references: [id], onDelete: Restrict)
  sunday_meeting_person_assignment sunday_meeting_person_assignment[]

  @@unique([sunday_meeting_id, order_index])
  @@unique([sunday_meeting_id, standard_slot])
  @@index([task_id])
}

model sunday_meeting_person_assignment {
  id                    String   @id @default(uuid())
  sunday_meeting_id     String
  sunday_meeting_item_id String?
  role                  String
  member_id             String?
  free_text_name        String?
  order_index           Int      @default(0)
  visitor_role          String?
  visitor_role_custom   String?
  is_presiding_override Boolean  @default(false)
  created_at            DateTime @default(now())
  updated_at            DateTime @default(now())

  sunday_meeting      sunday_meeting       @relation(fields: [sunday_meeting_id], references: [id], onDelete: Cascade)
  sunday_meeting_item sunday_meeting_item? @relation(fields: [sunday_meeting_item_id], references: [id], onDelete: Cascade)
  member              member?              @relation(fields: [member_id], references: [id], onDelete: Restrict)

  // SQLite partial unique indexes are declared in the initial migration because
  // Prisma 7.8 cannot express unique partial indexes in the schema DSL.
  @@index([member_id, role, sunday_meeting_id])
}
