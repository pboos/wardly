generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "sqlite"
}

model ward {
  id                   String   @id @default(uuid())
  name                 String
  type                 String   @default("ward") // 'ward' | 'branch'
  content_locale       String   @default("en")
  time_zone            String   @default("UTC")
  sacrament_start_time String?
  created_at           DateTime @default(now())
  updated_at           DateTime @default(now())

  user                       user[]
  member_tag                 member_tag[]
  member                     member[]
  task                       task[]
  task_type                  task_type[]
  task_type_state            task_type_state[]
  task_type_state_assignment task_type_state_assignment[]
  sunday_meeting             sunday_meeting[]
  leadership_meeting_series  leadership_meeting_series[]
  task_digest_delivery       task_digest_delivery[]
}

model user {
  id         String   @id @default(uuid())
  ward_id    String
  email      String
  name       String
  created_at DateTime @default(now())
  updated_at DateTime @default(now())

  ward                 ward                   @relation(fields: [ward_id], references: [id], onDelete: Cascade)
  login                login?
  task_digest_delivery task_digest_delivery[]

  agenda_templates meeting_agenda_template[]
  agenda_items meeting_agenda_item[]

  // Tasks assigned to this user
  task                       task[] @relation("TaskAssignee")
  owned_tasks                task[] @relation("TaskOwner")
  // States that reassign to this user
  task_type_state_assignment task_type_state_assignment[]

  @@unique([email])
  @@index([ward_id])
}

model login {
  user_id       String
  token_hash    String
  code_hash     String
  attempts      Int      @default(0)
  redirect_path String?
  created_at    DateTime @default(now())

  user user @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@id([user_id])
  @@unique([token_hash])
  @@index([created_at])
}

model member {
  id                      String                  @id @default(uuid())
  ward_id                 String
  external_uuid           String?
  external_household_uuid String?
  external_household_role String?
  first_name              String
  last_name               String
  // Restricted to m/f by the member_gender_check CHECK in the initial migration.
  gender                  String
  birth_date              String?
  email                   String?
  is_baptized             Boolean
  is_moved_out            Boolean                 @default(false)
  tag_assignments         member_tag_assignment[]
  created_at              DateTime                @default(now())
  updated_at              DateTime                @default(now())

  ward                ward                  @relation(fields: [ward_id], references: [id], onDelete: Cascade)
  task                task[]
  // Sunday agenda items that name this member (leader, presider, speaker, …)
  sunday_meeting_item sunday_meeting_item[]

  @@unique([ward_id, external_uuid])
  @@index([ward_id])
  @@index([ward_id, is_moved_out])
}

model task {
  id               String   @id @default(uuid())
  ward_id          String
  type             String
  state            String   @default("todo")
  title            String?
  description      String?
  assigned_user_id String?
  owner_user_id    String?
  member_id        String?
  due_date         String?
  priority         String   @default("normal") // 'urgent' | 'normal' | 'whenever'
  duration_minutes Int?
  completed_at     String?
  created_at       DateTime @default(now())
  updated_at       DateTime @default(now())

  ward                     ward                       @relation(fields: [ward_id], references: [id], onDelete: Cascade)
  assigned_user            user?                      @relation("TaskAssignee", fields: [assigned_user_id], references: [id], onDelete: SetNull)
  owner_user               user?                      @relation("TaskOwner", fields: [owner_user_id], references: [id], onDelete: SetNull)
  member                   member?                    @relation(fields: [member_id], references: [id], onDelete: SetNull)
  sunday_meeting_item      sunday_meeting_item[]
  meeting_agenda_item_task meeting_agenda_item_task[]

  @@index([ward_id])
  @@index([ward_id, type, state])
  @@index([assigned_user_id])
  @@index([owner_user_id])
  @@index([member_id])
  @@index([due_date])
  @@index([completed_at])
  @@index([ward_id, completed_at])
}

model task_type {
  ward_id       String
  type          String // Code-default or custom task type identifier
  name          String
  name_short    String   @default("T")
  color         String   @default("#71717a")
  configuration String   @default("{}")
  enabled       Boolean  @default(true)
  created_at    DateTime @default(now())
  updated_at    DateTime @default(now())

  ward ward @relation(fields: [ward_id], references: [id], onDelete: Cascade)

  @@id([ward_id, type])
}

model task_type_state {
  id                       String   @id @default(uuid())
  ward_id                  String
  task_type                String
  state                    String
  label                    String
  color                    String   @default("#3b82f6")
  order_index              Int      @default(0)
  state_group              String   @default("active") // 'not_started' | 'active' | 'closed'
  sunday_meeting_item_type String?
  created_at               DateTime @default(now())
  updated_at               DateTime @default(now())

  ward ward @relation(fields: [ward_id], references: [id], onDelete: Cascade)

  @@unique([ward_id, task_type, state])
  @@index([task_type])
  @@index([ward_id])
}

model task_type_state_assignment {
  ward_id           String
  task_type         String
  state             String
  assign_to_user_id String?
  created_at        DateTime @default(now())
  updated_at        DateTime @default(now())

  ward           ward  @relation(fields: [ward_id], references: [id], onDelete: Cascade)
  assign_to_user user? @relation(fields: [assign_to_user_id], references: [id], onDelete: SetNull)

  @@id([ward_id, task_type, state])
  @@index([assign_to_user_id])
}

model sunday_meeting {
  id          String   @id @default(uuid())
  ward_id     String
  date        String
  type        String
  information String?
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())

  ward                ward                  @relation(fields: [ward_id], references: [id], onDelete: Cascade)
  sunday_meeting_item sunday_meeting_item[]

  @@unique([ward_id, date])
  @@index([ward_id, type, date])
}

model sunday_meeting_item {
  id                String   @id @default(uuid())
  sunday_meeting_id String
  type              String
  section           String
  order_index       Int
  slot              String?
  content           String?
  metadata          String?
  person_member_id  String?
  person_name       String?
  task_id           String?
  created_at        DateTime @default(now())
  updated_at        DateTime @default(now())

  sunday_meeting sunday_meeting @relation(fields: [sunday_meeting_id], references: [id], onDelete: Cascade)
  task           task?          @relation(fields: [task_id], references: [id], onDelete: Restrict)
  member         member?        @relation(fields: [person_member_id], references: [id], onDelete: Restrict)

  // The person XOR CHECK (person_member_id / person_name) and the partial
  // unique indexes (at most one 'leader' and one 'presiding' per meeting) are
  // declared in the initial migration because Prisma 7.8 cannot express CHECK
  // constraints or unique partial indexes in the schema DSL.
  @@unique([sunday_meeting_id, slot])
  @@unique([task_id])
  @@index([sunday_meeting_id])
  @@index([person_member_id])
}

model task_digest_delivery {
  id               String    @id @default(uuid())
  ward_id          String
  user_id          String
  sunday_date      String
  status           String    @default("pending")
  claim_token      String?
  lease_expires_at DateTime?
  next_attempt_at  DateTime?
  attempts         Int       @default(0)
  sent_at          DateTime?
  last_error       String?
  created_at       DateTime  @default(now())
  updated_at       DateTime  @default(now())

  ward ward @relation(fields: [ward_id], references: [id], onDelete: Cascade)
  user user @relation(fields: [user_id], references: [id], onDelete: Cascade)

  @@unique([ward_id, user_id, sunday_date])
}

model member_tag {
  id                  String                  @id @default(uuid())
  ward_id             String
  name                String
  is_default_excluded Boolean                 @default(false)
  normalized_name     String
  color               String
  created_at          DateTime                @default(now())
  updated_at          DateTime                @default(now())
  ward                ward                    @relation(fields: [ward_id], references: [id], onDelete: Cascade)
  assignments         member_tag_assignment[]

  @@unique([ward_id, normalized_name])
}

model member_tag_assignment {
  id         String     @id @default(uuid())
  member_id  String
  tag_id     String
  created_at DateTime   @default(now())
  updated_at DateTime   @default(now())
  member     member     @relation(fields: [member_id], references: [id], onDelete: Cascade)
  tag        member_tag @relation(fields: [tag_id], references: [id], onDelete: Cascade)

  @@unique([member_id, tag_id])
  @@index([tag_id])
}

model leadership_meeting_series {
  id             String                    @id @default(uuid())
  ward_id        String
  kind           String
  schedule       String
  start_time     String                    @default("09:00")
  time_zone      String
  target_minutes Int                       @default(60)
  created_at     DateTime                  @default(now())
  updated_at     DateTime                  @default(now())
  ward           ward                      @relation(fields: [ward_id], references: [id], onDelete: Cascade)
  meetings       leadership_meeting[]
  templates      meeting_agenda_template[]
  topics         meeting_agenda_topic[]

  @@unique([ward_id, kind])
}

model leadership_meeting {
  id             String                    @id @default(uuid())
  series_id      String
  date           String
  scheduled_date String
  start_time     String
  status         String                    @default("planned")
  created_at     DateTime                  @default(now())
  updated_at     DateTime                  @default(now())
  series         leadership_meeting_series @relation(fields: [series_id], references: [id], onDelete: Cascade)
  items          meeting_agenda_item[]
  suggestion_receipts meeting_suggestion_receipt[]

  @@unique([series_id, scheduled_date])
  @@index([series_id, date])
}

model meeting_agenda_topic {
  id         String @id @default(uuid())
  series_id  String
  notes      String @default("")
  created_at DateTime @default(now())
  updated_at DateTime @default(now())
  series     leadership_meeting_series @relation(fields: [series_id], references: [id], onDelete: Cascade)
  templates  meeting_agenda_template[]

  @@index([series_id])
}

model meeting_agenda_template {
  topic_id String
  topic meeting_agenda_topic @relation(fields: [topic_id], references: [id], onDelete: Cascade)
  id                 String                      @id @default(uuid())
  series_id          String
  title              String
  instructions       String @default("")
  duration_minutes   Int
  recurrence         String
  anchor_date        String
  after_date         String?
  after_meeting_date String?
  default_assigned_user_id String?
  default_assigned_user user? @relation(fields: [default_assigned_user_id], references: [id], onDelete: SetNull)
  suggestion_key     String?
  archived           Boolean                     @default(false)
  position           Int                         @default(0)
  created_at         DateTime                    @default(now())
  updated_at         DateTime                    @default(now())
  series             leadership_meeting_series   @relation(fields: [series_id], references: [id], onDelete: Cascade)
  occurrences        meeting_agenda_occurrence[]

  @@index([series_id, archived])
  @@index([topic_id])
}

model meeting_agenda_occurrence {
  id             String                           @id @default(uuid())
  template_id    String
  occurrence_key String
  due_date       String
  status         String                           @default("pending")
  created_at     DateTime                         @default(now())
  updated_at     DateTime                         @default(now())
  template       meeting_agenda_template          @relation(fields: [template_id], references: [id], onDelete: Cascade)
  appearances    meeting_agenda_item_occurrence[]

  @@unique([template_id, occurrence_key])
}

model meeting_agenda_item {
  id               String                           @id @default(uuid())
  meeting_id       String
  title            String
  instructions     String @default("")
  duration_minutes Int
  position         Int
  outcome          String                           @default("pending")
  decision         String                           @default("")
  assigned_user_id String?
  assignment_overridden Boolean @default(false)
  assigned_user user? @relation(fields: [assigned_user_id], references: [id], onDelete: SetNull)
  predecessor_id   String?                          @unique
  created_at       DateTime                         @default(now())
  updated_at       DateTime                         @default(now())
  meeting          leadership_meeting               @relation(fields: [meeting_id], references: [id], onDelete: Cascade)
  predecessor      meeting_agenda_item?             @relation("continuation", fields: [predecessor_id], references: [id], onDelete: SetNull)
  successor        meeting_agenda_item?             @relation("continuation")
  occurrences      meeting_agenda_item_occurrence[]
  tasks            meeting_agenda_item_task[]

  @@index([meeting_id, position])
}

model meeting_agenda_item_occurrence {
  id            String                    @id @default(uuid())
  item_id       String
  occurrence_id String
  created_at    DateTime                  @default(now())
  updated_at    DateTime                  @default(now())
  item          meeting_agenda_item       @relation(fields: [item_id], references: [id], onDelete: Cascade)
  occurrence    meeting_agenda_occurrence @relation(fields: [occurrence_id], references: [id], onDelete: Cascade)

  @@unique([item_id, occurrence_id])
  @@index([occurrence_id])
}

model meeting_agenda_item_task {
  id         String              @id @default(uuid())
  item_id    String
  task_id    String
  created_at DateTime            @default(now())
  updated_at DateTime            @default(now())
  item       meeting_agenda_item @relation(fields: [item_id], references: [id], onDelete: Cascade)
  task       task                @relation(fields: [task_id], references: [id], onDelete: Cascade)

  @@unique([item_id, task_id])
  @@index([task_id])
}

model meeting_suggestion_receipt {
  id          String @id
  meeting_id  String
  fingerprint String
  created_at  DateTime @default(now())
  updated_at  DateTime @default(now())
  meeting     leadership_meeting @relation(fields: [meeting_id], references: [id], onDelete: Cascade)
}
